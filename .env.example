# QuantAI Environment Variables
ENVIRONMENT=development
EXECUTION_MODE=dry_run

# Exchange Credentials (Binance Spot)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Database & Cache
DATABASE_URL=sqlite:///user_data/quantai.db
REDIS_URL=redis://localhost:6379/0

# Risk Thresholds
MAX_DAILY_LOSS_PCT=0.02
MAX_TOTAL_DRAWDOWN_PCT=0.06
MAX_RISK_PER_TRADE_PCT=0.01
MAX_PORTFOLIO_EXPOSURE_PCT=0.50
KELLY_FRACTION=0.35

# Server Ports
API_HOST=0.0.0.0
API_PORT=8000
